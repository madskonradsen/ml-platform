# Production Prefect Worker with Flows Baked In
# Build this image and push to your container registry for production deployments

FROM prefecthq/prefect:3-python3.12

# Install flow dependencies
COPY ../../../flows/requirements.txt /opt/prefect/flows/requirements.txt
RUN pip install --no-cache-dir -r /opt/prefect/flows/requirements.txt

# Bake in the flows (immutable for production)
COPY ../../../flows/ /opt/prefect/flows/

# Set Python path so flows can be imported
ENV PYTHONPATH="/opt/prefect/flows:${PYTHONPATH}"

# Set working directory
WORKDIR /opt/prefect/flows

# Default command (worker start)
CMD ["prefect", "worker", "start", "--pool", "default-pool", "--type", "process"]
